{
  "name": "api-loggers",
  "version": "0.0.2",
  "description": "Shared Logger configurations for Node.js projects",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "logger",
    "winston",
    "typescript",
    "config",
    "tsconfig",
    "prettier",
    "react",
    "nextjs",
    "node",
    "shared-config"
  ],
  "author": "Anwar <anwarkamal1434@gmail.com>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/org-utils/app-logger.git"
  },
  "homepage": "https://github.com/org-utils/app-logger#readme",
  "bugs": {
    "url": "https://github.com/org-utils/app-logger/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0"
  },
  "scripts": {
    "clean:dist": "rm -rf ./dist",
    "build:types": "tsc -b",
    "build:js": "tsup",
    "build": "npm run clean:dist && npm run build:types && npm run build:js",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write 'src/**/*.ts'",
    "changesets:init": "changeset init",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish",
    "release": "npm run pre-build && changeset publish"
  }
}
